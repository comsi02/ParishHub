# 운영 환경의 CORS 프록시 주소입니다. 마지막 경로는 /MissaLoad 이어야 합니다.
# 개발 환경은 비워 두세요. Vite가 /api/cbck/MissaLoad로 프록시합니다.
VITE_MASS_API_URL=https://your-domain.example/api/cbck/MissaLoad

# 선택 사항: Firebase Function을 다른 도메인에 따로 배포한 경우에만 설정합니다.
# 같은 Firebase Hosting에 배포하면 비워 두세요 (/api/missa/YYYYMMDD 사용).
VITE_MASS_DETAIL_API_URL=https://your-domain.example/api/missa
