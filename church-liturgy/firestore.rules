rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // admins 컬렉션: 권한이 있는 사용자 목록
    // - 본인 문서만 읽기 허용 (로그인 체크용)
    // - 쓰기는 Firebase 콘솔에서만 (관리자가 직접 추가)
    // ─────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // masses 컬렉션
    // - 읽기: 관리자만
    // - 쓰기: 관리자만
    // ─────────────────────────────────────────
    match /masses/{massId} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      // slides 서브컬렉션
      match /slides/{slideId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // ─────────────────────────────────────────
    // presentation_state: 현재 발표 상태
    // - 읽기: 누구나 허용 (display 페이지 비인증 접근)
    // - 쓰기: 관리자만
    // ─────────────────────────────────────────
    match /presentation_state/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 헬퍼 함수: admins 컬렉션에 UID가 존재하는지 확인
    // ─────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
