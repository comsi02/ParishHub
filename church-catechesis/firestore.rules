rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // 헬퍼 (parish-hub-liturgy 공유 프로젝트)
    // ─────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // 전례 앱 관리자 (admins 컬렉션)
    function isLiturgyAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 최초 관리자 부트스트랩 (콘솔 없이 첫 관리자 확보)
    function isBootstrapCatechesisAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'stcomsi02@gmail.com'
        ];
    }

    // users.role == admin 또는 roles 배열에 admin 포함
    function hasCatechesisAdminRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.role == 'admin' ||
          (
            'roles' in get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.roles.hasAny(['admin'])
          )
        );
    }

    // 주일학교 앱 관리자
    function isCatechesisAdmin() {
      return isBootstrapCatechesisAdmin() ||
        hasCatechesisAdminRole() ||
        (isAuthenticated() &&
          exists(/databases/$(database)/documents/catechesis_admins/$(request.auth.uid)));
    }

    function isAnyAdmin() {
      return isLiturgyAdmin() || isCatechesisAdmin();
    }

    // 승인 + 프로필(Person) 연결 완료 사용자 (관리자 예외)
    function isCatechesisActiveUser() {
      return isCatechesisAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.status == 'approved' &&
        get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.keys().hasAll(['personId']) &&
        get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.personId is string &&
        get(/databases/$(database)/documents/catechesis_users/$(request.auth.uid)).data.personId.size() > 0
      );
    }

    // 하위 호환: 기존 isAdmin() = 전례 관리자
    function isAdmin() {
      return isLiturgyAdmin();
    }

    // ─────────────────────────────────────────
    // 전례 (church-liturgy)
    // ─────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == uid || isAnyAdmin());
      allow write: if false; // Firebase 콘솔에서만 추가
    }

    match /masses/{massId} {
      allow read, write: if isLiturgyAdmin();

      match /slides/{slideId} {
        allow read, write: if isLiturgyAdmin();
      }
    }

    match /presentation_state/{docId} {
      allow read: if true;
      allow write: if isLiturgyAdmin();
    }

    // ─────────────────────────────────────────
    // 주일학교 인증 · 승인
    // ─────────────────────────────────────────
    match /catechesis_users/{uid} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == uid || isCatechesisAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid
        && (!('personId' in request.resource.data) || request.resource.data.personId == null)
        && (
          isBootstrapCatechesisAdmin() ||
          (
            (!('roles' in request.resource.data) || !request.resource.data.roles.hasAny(['admin'])) &&
            (!('role' in request.resource.data) || request.resource.data.role != 'admin')
          )
        );
      // 본인은 role/roles/status/personId 변경 불가. 승인·Person 연결은 관리자만.
      allow update: if isCatechesisAdmin() || (
        isAuthenticated() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'roles', 'status', 'approvedAt', 'rejectedAt', 'personId', 'personLinkedAt'])
      );
    }

    match /catechesis_admins/{uid} {
      // 본인 문서 읽기 필수 (로그인 시 관리자 여부 확인)
      allow read: if isAuthenticated() &&
        (request.auth.uid == uid || isCatechesisAdmin());
      allow write: if isCatechesisAdmin();
    }

    // ─────────────────────────────────────────
    // 주일학교 데이터
    // ─────────────────────────────────────────
    match /catechesis_students/{studentId} {
      allow read, write: if isCatechesisActiveUser();
    }

    match /catechesis_parents/{parentId} {
      allow read, write: if isCatechesisActiveUser();
    }

    match /catechesis_teachers/{teacherId} {
      allow read: if isCatechesisActiveUser();
      allow write: if isAnyAdmin();
    }

    match /catechesis_attendance/{attendanceId} {
      allow read: if isCatechesisAdmin() || isCatechesisActiveUser();
      allow write: if isCatechesisAdmin();
    }

    // 학사 일정별 미사·전례 봉사 배정 (관리자만 수정)
    match /catechesis_duty_assignments/{dutyId} {
      allow read: if isCatechesisAdmin() || isCatechesisActiveUser();
      allow write: if isCatechesisAdmin();
    }

    match /catechesis_activities/{activityId} {
      allow read, write: if isCatechesisActiveUser();
    }

    match /catechesis_grace_ledger/{ledgerId} {
      allow read, write: if isCatechesisActiveUser();
    }

    match /catechesis_settings/{settingId} {
      allow read: if isCatechesisActiveUser();
      allow write: if isAnyAdmin();
    }

    // 등록 시트 임포트 Person (학부모·학생)
    match /catechesis_persons/{personId} {
      allow read: if isCatechesisAdmin() || isCatechesisActiveUser() || (
        isAuthenticated() &&
        resource.data.createdByUid == request.auth.uid
      );
      allow create: if isCatechesisAdmin() || isCatechesisActiveUser() || (
        isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.source == 'self_register' &&
        (
          request.resource.data.roles.hasOnly(['parent']) ||
          request.resource.data.roles.hasOnly(['student'])
        )
      );
      allow update: if isCatechesisAdmin() || isCatechesisActiveUser() || (
        isAuthenticated() &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.source == 'self_register' &&
        (
          request.resource.data.roles.hasOnly(['parent']) ||
          request.resource.data.roles.hasOnly(['student'])
        )
      );
      allow delete: if isCatechesisAdmin() || isCatechesisActiveUser();
    }

    // 주일학교 학사 일정
    match /catechesis_schedules/{scheduleId} {
      allow read: if isCatechesisAdmin() || isCatechesisActiveUser();
      allow write: if isCatechesisActiveUser();
    }

    // 주일학교 반 구성
    match /catechesis_classes/{classId} {
      allow read: if isCatechesisAdmin() || isCatechesisActiveUser();
      allow write: if isCatechesisActiveUser();
    }
  }
}
