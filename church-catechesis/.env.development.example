# church-catechesis 로컬 개발 환경 템플릿
# 복사: cp .env.development.example .env.development
#
# VITE_PROVIDER=firebase → Google 로그인 + Firestore(catechesis_users / catechesis_admins)
# VITE_PROVIDER=local    → LocalStorage 데모(오프라인)
VITE_PROVIDER=firebase
VITE_USE_EMULATOR=false

# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정
# 기본 프로젝트: parish-hub-catechesis (운영과 동일)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=parish-hub-catechesis.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parish-hub-catechesis
VITE_FIREBASE_STORAGE_BUCKET=parish-hub-catechesis.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
