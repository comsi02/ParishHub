# church-catechesis 운영(Production) 환경 템플릿
# 복사하여 .env.production 파일로 생성 후 실제 Firebase 키를 입력하세요.
VITE_PROVIDER=firebase
VITE_USE_EMULATOR=false

# Firebase 프로젝트 설정
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=parish-hub-liturgy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parish-hub-liturgy
VITE_FIREBASE_STORAGE_BUCKET=parish-hub-liturgy.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
